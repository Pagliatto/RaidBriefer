          "ko": "AMG-10 유압유 프라퍼에게 전달하기",
          "en": "Hand over the AMG-10 fluid to Prapor",
          "optional": false,
          "map": "reserve",
          "when": {
            "falling-skies@case": "given"
          }
        },
        {
          "id": "boreas-08",
          "ko": "인레이드 군용 전원 필터 3개 프라퍼에게 전달하기 (장갑 케이스를 가진 경우)",
          "en": "Hand over 3 found in raid Military power filters to Prapor",
          "optional": false,
          "map": null,
          "when": {
            "falling-skies@case": "kept"
          }
        },
        {
          "id": "boreas-09",
          "ko": "AMG-10 유압유 프라퍼에게 전달하기",
          "en": "Hand over the AMG-10 fluid to Prapor",
          "optional": false,
          "map": "reserve",
          "when": {
            "falling-skies@case": "kept"
          }
        },
